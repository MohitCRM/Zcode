const axios = require('axios');

const waiting = (timer) => {
    return new Promise((resolve) => setTimeout(resolve, timer));
};

const getlanguagebyid = (lang) => {
    if (!lang) return 54; 
    const languages = {
        "c++": 54,
        "java": 62,
        "python": 71,
        "javascript": 63,
        "ruby": 72,
        "go": 60,
        "c#": 51,
        "php": 68,
        "swift": 83,
        "kotlin": 78,
        "c": 50
    };
    return languages[lang.toLowerCase()] || 54;
};

const submitbatch = async (submissions) => {
    try {
        const options = {
            method: 'POST',
            url: "http://localhost:2358/submissions/batch",
            params: { base64_encoded: "true" },
            data: { submissions } 
        };

        const response = await axios.request(options);
        return response.data; 
    } catch (error) {
        console.error("Error submitting batch to Judge0:", error.response?.data || error.message);
        throw error;
    }
};

async function submittoken(tokens) {
    if (!tokens || tokens.length === 0) return [];

    try {
        const options = {
            method: 'GET',
            url: "http://localhost:2358/submissions/batch",
            params: {
                tokens: tokens.join(","),
                base64_encoded: "true",
            },
        };

        const response = await axios.request(options);
        const result = response.data;

        if (!result || !result.submissions) {
            await waiting(2000);
            return await submittoken(tokens);
        }

        const isresultobtained = result.submissions.every((r) => r && r.status_id > 2);

        if (isresultobtained) {
            return result.submissions;
        }

        await waiting(2000);
        return await submittoken(tokens);

    } catch (error) {
        console.error("Error polling tokens from Judge0:", error.response?.data || error.message);
        await waiting(2000);
        return await submittoken(tokens);
    }
}

module.exports = { getlanguagebyid, submitbatch, submittoken };